#!/usr/bin/env bash
# The backstop. pre-commit can be skipped with --no-verify and history can be rewritten,
# so the last gate before anything leaves the machine checks the actual range being sent.
#
# git feeds refs on stdin as: <local ref> <local sha> <remote ref> <remote sha>
set -euo pipefail
ROOT="$(git rev-parse --show-toplevel)"
ZERO=0000000000000000000000000000000000000000
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ "$local_sha" == "$ZERO" ]] && continue          # deleting a ref sends no content
  if [[ "$remote_sha" == "$ZERO" ]]; then
    # New branch: diff against whatever the remote already has, not the whole history —
    # scanning every commit ever made would be slow and would re-flag the past.
    base="$(git merge-base "$local_sha" HEAD 2>/dev/null || true)"
    range="${base:-$(git hash-object -t tree /dev/null)}..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  "$ROOT/bin/scan-secrets.py" --range "$range" || status=1
done

exit "$status"
